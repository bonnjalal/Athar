# Flask Application Settings
SECRET_KEY=change-this-to-a-secure-random-token-in-production
ENV=development
DEBUG=True

# Authentication Settings
# Set MOCK_AUTH=True to bypass Wikimedia OAuth during local development (DEBUG=True only; OAUTH_CLIENT_ID must be empty)
MOCK_AUTH=True
MOCK_USERNAME=MoroccoVolunteer
MOCK_IS_ADMIN=False

# Tool Governance & External Request Page
ADMIN_USERS=Bonnjalal00
DELETION_REQUEST_URL=

# Live Wikimedia OAuth 2.0 Credentials (Provided for production; leave empty when MOCK_AUTH=True)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://127.0.0.1:5000/oauth/callback

# Wikimedia MinT Machine Translation API
MINT_API_URL=https://translate.wmcloud.org/api
MINT_TIMEOUT_SECONDS=10

# Community & Data Customization (Generalizable Settings)
COMMUNITY_NAME=Wikimedia Morocco
META_ROSTER_PAGE=Wikimedia_MA/Members
DEFAULT_TARGET_WIKI=ar.wikipedia.org
CONTACT_EMAIL=contact@wikimedia.ma

# Production Toolforge Database Credentials (Auto-injected on Toolforge)
TOOL_NAME=athar
TOOL_DB_USER=
TOOL_DB_PASS=
